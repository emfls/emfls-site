---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles, categoryList } from '../data/articles';
---
<BaseLayout
  title="사이트맵 | EMFLS Guide"
  description="EMFLS Guide의 주요 페이지와 전체 글 링크를 한 곳에서 확인할 수 있습니다."
  canonical="/site-map/"
>
  <section class="simple-page">
    <p class="eyebrow">사이트맵</p>
    <h1>사이트 전체 보기</h1>
    <h2>주요 페이지</h2>
    <ul class="link-list">
      <li><a href="/">홈</a></li>
      <li><a href="/articles/">글 목록</a></li>
      <li><a href="/about/">소개</a></li>
      <li><a href="/contact/">문의</a></li>
      <li><a href="/editorial-policy/">편집 정책</a></li>
      <li><a href="/content-methodology/">콘텐츠 작성 기준</a></li>
      <li><a href="/disclaimer/">면책 고지</a></li>
      <li><a href="/privacy/">개인정보처리방침</a></li>
      <li><a href="/terms/">이용약관 및 면책 고지</a></li>
    </ul>
    <h2>주제별 글 모음</h2>
    <ul class="link-list">
      {categoryList.map((category) => (
        <li><a href={`/categories/${category.slug}/`}>{category.name}</a></li>
      ))}
    </ul>
    <h2>글</h2>
    <ul class="link-list">
      {articles.map((article) => (
        <li><a href={`/articles/${article.slug}/`}>{article.title}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
