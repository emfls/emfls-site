---
import GameLayout from '../layouts/GameLayout.astro';
import { games } from '../data/games';
import { gameCategories } from '../data/gameCategories';
import '../styles/support-pages.css';

const informationLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Privacy', href: '/privacy/' },
  { label: 'Terms', href: '/terms/' },
];
---
<GameLayout title="Site Map | EMFLS Games" description="Browse the main game, category, and information pages available on EMFLS Games." canonical="/site-map/" robots="noindex, follow" ogType="website">
  <div class="support-page">
    <div class="container support-page__inner">
      <header class="support-page__header">
        <p class="support-page__eyebrow">Site map</p>
        <h1>EMFLS Games Site Map</h1>
        <p class="support-page__lead">Find the main games, categories, and information pages on EMFLS Games.</p>
      </header>
      <div class="support-page__sections">
        <section class="support-section" aria-labelledby="support-main-heading"><h2 id="support-main-heading">Main</h2><nav class="support-link-grid" aria-label="Main pages"><a class="support-link-card" href="/">Home</a><a class="support-link-card" href="/games/">Games</a></nav></section>
        <section class="support-section" aria-labelledby="support-games-heading"><h2 id="support-games-heading">Games</h2><nav class="support-link-grid" aria-label="Games">{games.map((game) => <a class="support-link-card" href={game.href}>{game.name}</a>)}</nav></section>
        <section class="support-section" aria-labelledby="support-categories-heading"><h2 id="support-categories-heading">Categories</h2><nav class="support-link-grid" aria-label="Game categories">{gameCategories.map((category) => <a class="support-link-card" href={`/categories/${category.slug}/`}>{category.name}</a>)}</nav></section>
        <section class="support-section" aria-labelledby="support-information-heading"><h2 id="support-information-heading">Information</h2><nav class="support-link-grid" aria-label="Information pages">{informationLinks.map((link) => <a class="support-link-card" href={link.href}>{link.label}</a>)}</nav></section>
      </div>
    </div>
  </div>
</GameLayout>
