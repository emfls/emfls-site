---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles } from '../data/articles';
---
<BaseLayout
  title="페이지를 찾을 수 없습니다 | EMFLS Guide"
  description="요청한 페이지를 찾을 수 없습니다. 홈이나 글 목록으로 이동해 주세요."
>
  <section class="simple-page">
    <p class="eyebrow">404</p>
    <h1>페이지를 찾을 수 없습니다.</h1>
    <p class="lead">주소가 바뀌었거나 입력한 경로가 정확하지 않을 수 있습니다.</p>
    <p><a class="button" href="/">홈으로 이동</a></p>
    <h2>최근 글</h2>
    <ul class="link-list">
      {articles.slice(0, 5).map((article) => (
        <li><a href={`/articles/${article.slug}/`}>{article.title}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
