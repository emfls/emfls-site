---
import GameLayout from '../layouts/GameLayout.astro';
import '../styles/support-pages.css';
---
<GameLayout title="Page Not Found | EMFLS Games" description="The page you requested could not be found. Return to EMFLS Games or browse all games." canonical={null} robots="noindex, follow" ogType="website">
  <div class="support-page error-page">
    <div class="container support-page__inner">
      <section class="error-page__content" aria-labelledby="error-page-heading">
        <p class="support-page__eyebrow">404</p>
        <h1 id="error-page-heading">Page not found.</h1>
        <p class="support-page__lead">The address may be incorrect, or the page may no longer be available.</p>
        <div class="error-page__actions"><a class="button" href="/">Back to Home</a><a class="button button--secondary" href="/games/">Browse Games</a></div>
      </section>
    </div>
  </div>
</GameLayout>
