---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles, articleCluster, categoryList } from '../../data/articles';

export function getStaticPaths() {
  return categoryList.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const categoryArticles = articles.filter((article) => articleCluster[article.slug] === category.name);
---
<BaseLayout
  title={`${category.name} 글 모음 | EMFLS Guide`}
  description={category.description}
  canonical={`/categories/${category.slug}/`}
>
  <section class="simple-page category-page">
    <p class="eyebrow">주제 클러스터</p>
    <h1>{category.name} 글 모음</h1>
    <p class="lead">{category.description}</p>
    <div class="category-summary"><strong>{categoryArticles.length}개 글</strong><span>개념을 잡고 실제 설정과 점검 글로 이어지는 흐름으로 구성했습니다.</span></div>
  </section>
  <section class="section">
    <div class="container content-grid">
      {categoryArticles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>
