---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles, categoryList } from '../data/articles';
import { site } from '../data/site';

const featured = articles.slice(0, 6);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    description: '개인 도메인, DNS, GitHub Pages, Cloudflare Pages, 정적 사이트 운영을 다루는 한국어 가이드입니다.',
    inLanguage: 'ko-KR',
    publisher: {
      '@type': 'Organization',
      name: site.name,
      url: site.url,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    contactPoint: {
      '@type': 'ContactPoint',
      email: site.author.email,
      contactType: 'editorial',
      availableLanguage: 'Korean',
    },
  },
];
---
<BaseLayout
  title="EMFLS Guide | 개인 도메인과 GitHub Pages 운영 가이드"
  description="개인 도메인, DNS, GitHub Pages, 정적 사이트 운영을 초보자도 따라갈 수 있게 정리하는 한국어 가이드입니다."
  schema={schema}
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">개인 웹사이트 운영 가이드</p>
      <h1>도메인 구매부터 GitHub Pages 공개까지 차근차근 정리합니다.</h1>
      <p class="lead">
        EMFLS Guide는 개인 도메인, DNS, 정적 사이트 제작, 검색 접근성, 운영 정책을 실제 사이트 운영 관점에서 설명합니다.
      </p>
      <div class="hero-actions">
        <a class="button" href="/articles/">글 목록 보기</a>
        <a class="button secondary" href="/site-map/">사이트맵 보기</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">운영 기준</p>
        <h2>처음 만드는 개인 사이트가 놓치기 쉬운 부분을 먼저 다룹니다.</h2>
      </div>
      <div class="panel">
        <h3>주요 범위</h3>
        <ul class="check-list">
          {categoryList.map((category) => (
            <li><a href={`/categories/${category.slug}/`}>{category.name}</a> - {category.description}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">최근 글</p>
      <div class="content-grid">
        {featured.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>
</BaseLayout>
