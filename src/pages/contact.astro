---
import GameLayout from '../layouts/GameLayout.astro';
import '../styles/trust-pages.css';
---
<GameLayout title="Contact EMFLS Games" description="Contact EMFLS Games about gameplay issues, accessibility, site problems, privacy questions, or general feedback." canonical="/contact/" robots="index, follow" ogType="website">
  <div class="trust-page"><div class="container trust-page__inner">
    <header class="trust-page__header"><p class="trust-page__eyebrow">Contact</p><h1>Contact EMFLS Games</h1><p class="trust-page__lead">Send feedback or report a problem with a game or the site.</p></header>
    <div class="trust-page__content">
      <section class="contact-card"><p class="trust-page__eyebrow">Email</p><h2>Send us a message</h2><a class="contact-email" href="mailto:contact@emfls.com">contact@emfls.com</a><p class="contact-note">We read messages sent to this address, but we cannot guarantee an individual response to every message.</p></section>
      <section class="trust-section"><h2>What to include</h2><ul class="trust-list"><li>The game name, if applicable</li><li>Your device and browser</li><li>What you expected to happen</li><li>What happened instead</li><li>Steps to reproduce the problem</li></ul></section>
      <section class="trust-section"><h2>You can also contact us about</h2><ul class="trust-list"><li>Accessibility</li><li>Privacy questions</li><li>Broken links</li><li>General site feedback</li></ul></section>
      <nav class="trust-actions" aria-label="Policy links"><a class="button button--secondary" href="/privacy/">Privacy</a><a class="button button--secondary" href="/terms/">Terms</a></nav>
    </div>
  </div></div>
</GameLayout>
