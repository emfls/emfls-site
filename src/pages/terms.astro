---
import GameLayout from '../layouts/GameLayout.astro';
import '../styles/trust-pages.css';
---
<GameLayout title="Terms of Use | EMFLS Games" description="Read the basic terms for using EMFLS Games and its browser-based games." canonical="/terms/" robots="index, follow" ogType="website">
  <div class="trust-page"><div class="container trust-page__inner">
    <header class="trust-page__header"><p class="trust-page__eyebrow">Terms</p><h1>Terms of Use</h1><p class="trust-meta">Last updated: September 24, 2026</p></header>
    <div class="trust-page__content">
      <section class="trust-section"><h2>Using EMFLS Games</h2><p>You may use EMFLS Games and its browser games for personal, lawful use. Do not interfere with the operation, security, or availability of the site.</p></section>
      <section class="trust-section"><h2>Games and availability</h2><p>Games and features may change, and permanent availability is not guaranteed. Browsers and devices can behave differently, and the service may be updated or temporarily unavailable.</p></section>
      <section class="trust-section"><h2>Game results</h2><p>Scores and results are entertainment features. They do not represent monetary prizes, gambling, or a guarantee that local or session results will be preserved.</p></section>
      <section class="trust-section"><h2>Acceptable use</h2><ul class="trust-list"><li>Do not deliberately disrupt the site.</li><li>Do not send abusive automated requests.</li><li>Do not attempt to bypass technical restrictions.</li><li>Do not use the service for unlawful activity.</li><li>Do not redistribute substantial original site or game content as if it were your own.</li></ul></section>
      <section class="trust-section"><h2>Original content</h2><p>Unless otherwise stated, original text, interface design, and game materials on EMFLS Games are provided as part of this site and should not be republished or commercially redistributed in substantial form without permission.</p></section>
      <section class="trust-section"><h2>External links</h2><p>External links, if provided, lead to services that operate under their own terms and privacy policies.</p></section>
      <section class="trust-section"><h2>Changes to these terms</h2><p>These terms may be updated as the site and its features change. The date above indicates the latest update.</p></section>
      <section class="trust-section"><h2>Contact</h2><p>Questions about these terms can be sent to <a href="mailto:contact@emfls.com">contact@emfls.com</a>.</p></section>
    </div>
  </div></div>
</GameLayout>
