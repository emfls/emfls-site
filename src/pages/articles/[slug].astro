---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, getArticleMeta, slugifyTag } from '../../data/articles';
import { getArticleEnhancement } from '../../data/articleEnhancements';
import { site } from '../../data/site';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const enhancement = getArticleEnhancement(article.slug);
const articleMeta = getArticleMeta(article);
const articleUrl = `${site.url}/articles/${article.slug}/`;
const relatedArticles = articles
  .filter((item) => item.slug !== article.slug && item.category === article.category)
  .slice(0, 3);
const fallbackRelatedArticles = articles
  .filter((item) => item.slug !== article.slug && item.category !== article.category)
  .slice(0, 3 - relatedArticles.length);
const related = [...relatedArticles, ...fallbackRelatedArticles];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.description,
    datePublished: article.date,
    dateModified: site.reviewedDate,
    author: {
      '@type': 'Person',
      name: site.author.name,
    },
    publisher: {
      '@type': 'Organization',
      name: site.name,
      url: site.url,
    },
    mainEntityOfPage: articleUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '홈',
        item: site.url,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '글 목록',
        item: `${site.url}/articles/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: article.title,
        item: articleUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: enhancement.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---
<BaseLayout
  title={`${article.title} | EMFLS Guide`}
  description={article.description}
  canonical={`/articles/${article.slug}/`}
  ogType="article"
  schema={schema}
>
  <article class="article-shell">
    <header class="article-header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">홈</a>
        <span>/</span>
        <a href="/articles/">글 목록</a>
        <span>/</span>
        <span>{article.category}</span>
      </nav>
      <span class="tag">{article.category}</span>
      <h1>{article.title}</h1>
      <p class="lead">{article.hero}</p>
      <div class="meta">
        <span>작성일 {article.date}</span>
        <span>최종 검토 {site.reviewedDate}</span>
        <span>작성자 {site.author.name}</span>
        <span>{article.readingTime}</span>
      </div>
      <div class="tag-row">
        {articleMeta.tags.map((tag) => (
          <a class="mini-tag" href={`/tags/${slugifyTag(tag)}/`}>{tag}</a>
        ))}
      </div>
    </header>
    <div class="article-body">
      <aside class="trust-box" aria-label="작성자 정보">
        <strong>{site.author.name}</strong>
        <p>{site.author.description}</p>
        <p>이 글은 개인 웹사이트 운영자가 실제 배포와 도메인 설정 과정에서 확인해야 할 항목을 초보자 기준으로 정리한 문서입니다.</p>
      </aside>
      {article.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.body.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))}
      <section>
        <h2>{enhancement.example.title}</h2>
        {enhancement.example.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>
      <section class="screenshot-placeholder">
        <h2>{enhancement.screenshot.title}</h2>
        <div class="placeholder-frame" aria-label="추후 추가할 스크린샷 자리">
          <span>스크린샷 추가 예정</span>
        </div>
        <p>{enhancement.screenshot.caption}</p>
      </section>
      <section>
        <h2>실전 점검표</h2>
        <ul class="check-list">
          {enhancement.checklist.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      <section class="callout">
        <h2>흔한 실수</h2>
        <ul>
          {enhancement.mistakes.map((mistake) => <li>{mistake}</li>)}
        </ul>
      </section>
      <section>
        <h2>자주 묻는 질문</h2>
        <div class="faq-list">
          {enhancement.faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
      <section>
        <h2>관련 글</h2>
        <ul class="related-list">
          {related.map((item) => (
            <li><a href={`/articles/${item.slug}/`}>{item.title}</a></li>
          ))}
        </ul>
      </section>
      <section>
        <h2>참고한 공식 문서</h2>
        <ul class="source-list">
          {enhancement.sources.map((source) => (
            <li><a href={source.url} rel="nofollow noopener" target="_blank">{source.name}</a></li>
          ))}
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>
