---
const { article } = Astro.props;
const icon = article.icon ?? 'document';
const iconLabel: Record<string, string> = {
  compass: '◇',
  branch: '⌁',
  network: '◎',
  layout: '▦',
  shield: '◈',
  search: '⌕',
  rocket: '▲',
  document: '□',
};
---
<a class={`article-card card-${icon}`} href={`/articles/${article.slug}/`}>
  <div class="card-visual" aria-hidden="true">
    <span>{iconLabel[icon] ?? iconLabel.document}</span>
    <small>{article.category}</small>
  </div>
  <div class="meta">
    <span class="tag">{article.category}</span>
    {article.series && <span>{article.series}</span>}
  </div>
  <h3>{article.title}</h3>
  <p>{article.summary ?? article.description}</p>
  <div class="tag-row">
    {(article.tags ?? []).slice(0, 3).map((tag) => <span class="mini-tag">{tag}</span>)}
  </div>
  <span class="meta card-meta">{article.updatedAt ?? article.date} · {article.readingTimeMinutes ?? article.readingTime}분</span>
</a>
