---
import '../../styles/games/twin-ledger.css';
---
<div class="twin-ledger" data-twin-ledger data-state="IDLE" tabindex="-1">
  <section class="twin-ledger__game" aria-label="Twin Ledger game">
    <div class="twin-ledger__hud" aria-label="Game status">
      <div class="twin-ledger__hud-item"><span>Turn</span><strong data-turn>0 / 18</strong></div>
      <div class="twin-ledger__hud-item"><span>Difference</span><strong data-difference>0</strong></div>
      <div class="twin-ledger__hud-item"><span>Zone</span><strong data-zone>Exact</strong></div>
      <div class="twin-ledger__hud-item"><span>Score · Combo</span><strong><span data-score>—</span> · <span data-combo>—</span></strong></div>
    </div>

    <div class="twin-ledger__ledgers" aria-label="Ledger totals">
      <section class="twin-ledger__ledger twin-ledger__ledger--left" aria-labelledby="twin-ledger-left-heading">
        <h3 id="twin-ledger-left-heading">Left Ledger</h3>
        <strong class="twin-ledger__total" data-left-total>0</strong>
        <button class="twin-ledger__place" type="button" data-action="left" aria-label="Place tile in Left Ledger" disabled>Place Left</button>
      </section>
      <section class="twin-ledger__ledger twin-ledger__ledger--right" aria-labelledby="twin-ledger-right-heading">
        <h3 id="twin-ledger-right-heading">Right Ledger</h3>
        <strong class="twin-ledger__total" data-right-total>0</strong>
        <button class="twin-ledger__place" type="button" data-action="right" aria-label="Place tile in Right Ledger" disabled>Place Right</button>
      </section>
    </div>

    <div class="twin-ledger__tile-row" aria-label="Tile preview">
      <div class="twin-ledger__tile twin-ledger__tile--current">
        <span>Current tile</span>
        <strong data-current-tile>—</strong>
      </div>
      <div class="twin-ledger__tile twin-ledger__tile--next" data-next-preview>
        <span data-next-label>Next preview</span>
        <strong data-next-tile>Shown when the session starts</strong>
      </div>
    </div>

    <section class="twin-ledger__history" aria-label="Recent placements">
      <h3>Recent placements</h3>
      <ol data-recent-history><li>No placements yet.</li></ol>
    </section>

    <div class="twin-ledger__balance" role="meter" aria-label="Balance difference" aria-valuemin="0" aria-valuemax="8" aria-valuenow="0" data-balance-meter>
      <span class="twin-ledger__balance-label">Balance meter</span>
      <span class="twin-ledger__balance-track" aria-hidden="true"><span data-balance-fill></span></span>
      <strong>Hard limit <span data-hard-limit>8</span></strong>
    </div>

    <div class="twin-ledger__panels">
      <section class="twin-ledger__panel" data-panel="IDLE" aria-labelledby="twin-ledger-idle-heading">
        <h3 id="twin-ledger-idle-heading">Ready to balance?</h3>
        <p>Place signed tiles across both ledgers for 18 turns.</p>
        <button class="button" type="button" data-action="start">Start Game</button>
      </section>

      <section class="twin-ledger__panel" data-panel="TURN" aria-label="Choose a ledger" hidden>
        <p>Select the ledger for this tile.</p>
      </section>

      <p class="twin-ledger__panel twin-ledger__status" data-panel="RESOLVING" role="status" hidden>Balancing the ledgers.</p>
      <p class="twin-ledger__panel twin-ledger__status" data-panel="FEEDBACK" role="status" aria-live="polite" aria-atomic="true" hidden><span data-feedback-detail>Placement resolved.</span></p>

      <section class="twin-ledger__panel" data-panel="PAUSED" aria-labelledby="twin-ledger-paused-heading" hidden>
        <h3 id="twin-ledger-paused-heading">Paused</h3>
        <p>Resume when you are ready.</p>
        <button class="button" type="button" data-action="resume">Resume</button>
      </section>

      <section class="twin-ledger__panel" data-panel="RESULT" aria-labelledby="twin-ledger-result-heading" hidden>
        <h3 id="twin-ledger-result-heading">Result</h3>
        <dl class="twin-ledger__result-grid">
          <div><dt>Score</dt><dd data-result="score">—</dd></div>
          <div><dt>Final Difference</dt><dd data-result="final-difference">—</dd></div>
          <div><dt>Exact Count</dt><dd data-result="exact-count">—</dd></div>
          <div><dt>Breach Count</dt><dd data-result="breach-count">—</dd></div>
          <div><dt>Max Combo</dt><dd data-result="max-combo">—</dd></div>
          <div><dt>Best Score</dt><dd data-result="best-score">—</dd></div>
        </dl>
        <button class="button" type="button" data-action="play-again" disabled>Play Again</button>
      </section>
    </div>
    <p class="twin-ledger__session-error" data-session-error role="alert" aria-live="assertive" hidden></p>
  </section>
</div>

<script>
  import { createTwinLedgerController } from '../../games/twin-ledger/controller';

  const initializeTwinLedger = (): void => {
    document.querySelectorAll<HTMLElement>('[data-twin-ledger]').forEach((root) => {
      if (!root.dataset.controllerReady) {
        createTwinLedgerController(root);
        root.dataset.controllerReady = 'true';
      }
    });
  };

  document.addEventListener('astro:page-load', initializeTwinLedger);
  window.addEventListener('pageshow', initializeTwinLedger);
  initializeTwinLedger();
</script>
